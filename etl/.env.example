# ── Kafka ──────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PRODUCTS=amazon.products
KAFKA_TOPIC_EVENTS=ecommerce.events
KAFKA_GROUP_ID=dwh-consumer-group
WINDOW_SECONDS=30

# ── PostgreSQL ─────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=dwh_user
DB_PASS=12345
DB_NAME=ecommerce_dwh

# ── Producers ──────────────────────────────────────────────────────────
COUNT=100